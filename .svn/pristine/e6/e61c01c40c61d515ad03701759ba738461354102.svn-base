#pragma pack(push,1)
////////////////////////////////
union EXIF_DATE
{
	struct
	{
		char y[4],		// year
			sep1,		// :
			m[2],		// month
			sep2,		// :
			d[2],		// day
			sep3,		// space or 'T'
			h[2],		// hour
			sep4,		// :
			n[2],		// minute
			sep5,		// :
			s[2];		// second
	};
	char buf[20];
};
#pragma pack(pop)	// back to default

////////////////////////////////
template <class T> T sa_abs(T a) { return (a > 0 ? a : -a); }
class DateTimeShift
{
public:
	// 0 for '_y'..'_s' means not set/no change, other values are +-
	int _y = 0,	   // year 2000 ..
		_m = 0,	   // month 1 .. 12
		_d = 0,	   // day, 1 .. 31
		_h = 0,	   // hour 0 .. 23
		_n = 0,    // minute 0 .. 59
		_s = 0;    // second 0 .. 59
	int _leapy = 0;
	bool _valid = false;

	long long _sec; // since 2000.01.01. 00:00:00
	bool _secIsOk = false;	// '-sec' already calculated?
	bool _keepOld = false;	// keep old files
	bool _setDate = false;	// use data as new exif date (options -t)
	bool _setTime = false;	// use time as new exif time (options -t)

	int IsLeapYear() { int y = sa_abs(_y);  return y > 0 && ((y % 4) == 0) && ((y % 100 != 0) || (y % 400 == 0)); }

	bool DateValid();
	bool TimeValid();

	DateTimeShift& operator+=(DateTimeShift sh);
	DateTimeShift& operator=(const DateTimeShift sh);
	bool operator==(const DateTimeShift sh) const 
	{
		return _y == sh._y &&_m == sh._m &&_d == sh._d &&_h == sh._n &&_m == sh._n &&_s == sh._s;
	}

	void ToSec();	// calculate Date&Time to seconds since 2000
					// Expects all values that are set are valid
					// but they need not be set (may be 0)
	void FromSec();
	bool SetDate(STRING sD); // SD format: YYYYMMDD[HHmm[SS]]
	bool SetTime(STRING sT); // format: HHMM[SS]
};

///////////////////////////
class ModDate
{
public:
	friend std::ostream &operator<<(std::ostream &os, const ModDate &md);

	ModDate(STRING name, DateTimeShift sh, DateTimeShift tsh) : name(name), dtsh(sh), ttsh(tsh) { dtsh.ToSec(); keepOld = dtsh._keepOld; }
	~ModDate() { delete[] pbuf; }

	int ReadImageFile(); // whole file into memory. return 0 if OK, < 0 if error
	int Modify(bool isSave = true);	// isTest when only display original EXIF date but do not create new file

private:
	DateTimeShift	dtsh,	// modify exif date with this set from other options than -t
					ttsh,	// this is set from option '-t'
					edtsh;	// date read from EXIF of file
	STRING name, newname;
	bool keepOld = false;
	char *pbuf = nullptr,	// file data is read to here
		*pos,   // in pbuf
		*pose;  // points AFTER EOF in memory
	int size;
	char ddelim, // delimiter between date section (':' or '-') 
		delim,	// delimiter between date and time: either space of 'T'
		ech;	// character after exif date STRING

	EXIF_DATE *ped = 0;

	bool GetExifDate();
	void _SetExifDate();

	int _Modify();	// find from pos in pb and modify it
};
