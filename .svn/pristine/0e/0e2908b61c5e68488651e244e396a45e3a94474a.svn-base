#include "stdafx.h"

#include <iostream>
#include <iomanip>
#include <fstream>

#include <regex>

#include "safiles.h"

#include <filesystem>

#ifdef _MSC_VER
	#include <Windows.h>
	#include <WinBase.h>
	#include <fileapi.h>	// GetFileTime
	#include <io.h>

	#include <dos.h>
	#include <direct.h>
#endif

using namespace std;

SA_FILES::SA_FILES(STRING path, bool isDir) : _path(path), _isDir(isDir)
{
	_NormalizePath(_path, _isDir);
	if (_isDir)						// then find all files in dir
		_path += L("*");
	STRING p = _path;				// name to searcg for in directory
	STRING pat;						// regular expression pattern in file name
		// look for regular expressions
	if (_isRegex(p))	// not simply a file name
	{
		pat = _Name();			// then separate pattern (otherwise it is empty)
		p = _Path() + L('*');	// and set mask to get all files to test against pattern
	}

#ifdef _MSC_VER
	struct _tfinddata_t ft;
	intptr_t handle;
	if ((handle = _tfindfirst(p.c_str(), &ft)) != -1)
	{
		if( ((ft.attrib & (_A_SUBDIR | _A_SYSTEM | _A_HIDDEN)) == 0) &&	// only get normal files in directory
				_match(ft.name, pat) )									// and if match then
			_slNames.push_back(ft.name);

		while (!_tfindnext(handle, &ft))
		{
			if (((ft.attrib & (_A_SUBDIR | _A_SYSTEM | _A_HIDDEN)) == 0) &&	// only get normal files in directory
				_match(ft.name, pat))									// and if match then
				_slNames.push_back(ft.name);
		}
	}
	_findclose(handle);
#endif
}

STRING SA_FILES::_NormalizePath(STRING &str, bool isDir)
{
	for (size_t i = 0; i != str.length(); ++i)
		if (str[i] == L('\\'))
			str[i] = L('/');
	if (isDir && str[str.length() - 1] != L('/'))
		str += L("/");
	return str;
}

STRING SA_FILES::_NativePath(STRING &str) const		// expects normalized path, returns one with OS delimiters
{
	if (PATH_DELIMITER == L('/'))
		return str;
	for (size_t i = 0; i != str.length(); ++i)
		if (str[i] == L('/'))
			str[i] = L('/');

}

STRING SA_FILES::_Name(STRING s)	const					// part of _path after the last delimiter
{
	if (s.empty())
		s = _path;
	size_t pos = s.find_last_of(L('/'));
	if (pos == s.npos)
		return s;
	else
		return s.substr(pos + 1);
}

STRING SA_FILES::_Path(STRING s) const						// path of file name in _path
{
	if (s.empty())
		s = _path;
	size_t pos = s.find_last_of(L('/'));
	if (pos == s.npos)
		return STRING();
	else
		return s.substr(0, pos);		// including '/' at the end
}

bool SA_FILES::_isRegex(STRING s)
{
	return true;
}

bool SA_FILES::_match(STRING name, STRING pattern)
{
	if (pattern.empty())
		return name == pattern;

	try
	{
		REGEX r(pattern);
		return regex_match(name, r);
	}
	catch(std::regex_error& e)
	{
		CERR << L("Error in regular expression \"") + pattern + L(")");
	}
}

STRING SA_FILES::Path(size_t which) const	// which-th name w.o. ending delimiter
{
	if (which >= _slNames.size())
		return STRING();
	STRING s = _Path(_slNames[which]);
	return _NativePath(s);
}

STRING SA_FILES::File(size_t which) const	// which-th name w.o. path
{
	if (which >= _slNames.size())
		return STRING();
	return _Name(_slNames[which]);
}

STRING SA_FILES::Name(size_t which) const	// full path name for the which-th file
{
	STRING s;
	if (which >= _slNames.size())
		return s;
	s = _slNames[which];		// full name
	return _NativePath(s);
}