#pragma once
// directory and file handling functions
#include "stdafx.h"

#include <vector>
#include <string>
#include <iostream>

typedef std::vector<STRING> STRINGLIST;

#ifdef __linux__
	#define PATH_DELIMITER L('/')
#else
	#define PATH_DELIMITER L('\\')
#endif

class SA_FILES
{
	STRINGLIST _slNames;	// from paths added by Add()

	STRING _NormalizePath(STRING &s, bool isDir = false);	// replaces '\\' with '/'
	STRING _NativePath(STRING &s) const;		// expects normalized path, returns one with OS delimiters
	STRING _Name(STRING s = STRING()) const;				// part of _path after the last delimiter
	STRING _Path(STRING s = STRING()) const;				// path of file name in _path
	bool _isRegex(STRING s);
	bool _match(STRING name, STRING pattern, bool &ok);		// ok: reg. expression was OK ?
public:
	SA_FILES() {}
	int Add(STRING path, bool isDir = false);
	virtual ~SA_FILES() {}
	STRING Path(size_t which) const;	// which-th name w.o. ending delimiter
	STRING File(size_t which) const;	// which-th name w.o. path
	STRING Name(size_t which) const;	// full path name for the which-th file

	int Count() const { return (int)_slNames.size(); }
};
