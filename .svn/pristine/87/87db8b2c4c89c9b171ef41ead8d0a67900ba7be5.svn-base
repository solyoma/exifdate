using namespace std;

//---------------------------------------------------------------------------

TCHAR szProgramName[144];
TCHAR szProgramDir[144];

/*======================================================================*/
STRING GetProgramName(TCHAR *pszPath)
/*----------------------------------------------------------------------*/
{
	STRING s = pszPath;
	for (size_t i = 0; i < s.length(); ++i)
		if (s[i] == '\\')
			s[i] = '/';
	size_t pos = s.find_last_of('/');
	if (pos != s.npos)
		s = s.substr(pos + 1);

	return s;
}
/*======================================================================*/
int AlgoEng(STRING sName)
/*----------------------------------------------------------------------*/
{
	COUT << sName << "\n"
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789
		"EXPECTS: File contains EXIF date and time info (maybe more than one position)\n"
		"        in one of the following ASCII formats:\n"								   
		"		\"YYYY-MM-DDTHH:MM:SS\" or \"YYYY:MM:DD HH:MM:SS\"\n"					   
		"        If a file does not contain any such date and time information it will\n"
		"        not be modified. There are some special files (e.g. .XMP sidecar files)\n"
		"        which contain more than one EXIF date and time. For such files only \n"
		"        EXIF dates and times, which are the same as the first one in the file\n"
		"        are modified.\n"   
		"ALGORITHM: 1. Read in the list of all files specified.\n"						   
		"           2. Convert (+ / -) offset dates and times to seconds\n"				   
		"           3. For all files in list\n"											   
		"              3.1 Read whole file in memory completely and scan for EXIF format\n"
		"                  date and time embedded in it. \n"							   
		"              3.2.If found save it for checks else move to the next file\n"	   
		"                  For all EXIF dates and times in the file which are the same\n"
		"                  as the first one saved do the following:\n"					   
		"                a. If option -t was given replace EXIF date and/or time from it\n"
		"                b. For option -tt replace EXIF time with it\n"					   
		"                c. Convert EXIF date and time to seconds elapsed since\n"		   
		"                       " << BASE_YEAR << ".01.01. 00:00:00\n"					   
		"                d. Add offset in seconds to EXIF seconds.\n"					   
		"                e. Convert EXIF seconds back to EXIF format date and time with\n"
		"                   the correct delimiters and put them into the data in memory\n"
		"                f. If option -l is used the modified EXIF date is echoed in\n"   
		"                   terminal, no more EXIF date is searched and we continue with\n"
		"                   the next file\n"
		"              3.3. If option -l was not given write new file to disk under a\n"
		"                   temporary name. The original file does not change.\n"
		"              3.4. If the write is successfull rename the original file: append\n"
		"                   a tilde (~) to the name\n"
		"              3.5. If the -n option was given delete the original file\n"		   
		"              3.6. Rename the new file to the original file name and set\n"	   
		"                   the file dates to that of the original.\n"
		"(C) András Sólyom 2015-2016\n";
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789
		return(1);
}

/*======================================================================*/
int AlgoHu(STRING sName)
/*----------------------------------------------------------------------*/
{
	COUT << sName << "\n"
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789
		"A mûködés alapelve: a fájlnak van EXIF fejléce és abba a dátum és idõ be van\n"  
		"írva, akár többször is a következõ formátumok egyikében:\n"					  
		"		\"ÉÉÉÉ-HH-NNTÓÓ:PP:SS\" or \"ÉÉÉÉ:HH:MM ÓÓ:PP:SS\"\n"					  
		"Ha egy fájlban ilyenek nincsenek, akkor a program azokat nem módosítja! Vannak\n"
		"olyan kép segédfájlok (Pl. .XMP fájlok), amelyekben több különbözõ dátum is van\n"
		"Ezek közül csak a kép készítésének dátumai íródnak át, a módosítás dátumai nem.\n\n"
		"ALGORITMUS: 1. beolvassuk az összes megadott fájl adatait egy listába.\n"		  
		"            2. A változtató adatokat átszámoljuk (+, vagy -) másodpercekre.\n"	  
		"            3. A beolvasott fájl listában szereplõ minden fájlra:\n"			  
		"              3.1. Beolvassuk a teljes fájlt és keresünk benne EXIF formájú\n"
		"                   dátumokat.\n"
		"              3.2. Ha találunk megjegyezzük az elsõt. Minden megtalált EXIF\n"
		"                   dátumra ami az elsõvel azonos (beleértve saját magát is)\n"
		"                   elvégezzük a következõket:\n"											  
		"                a. Ha -t volt megadva, akkor lecseréljük a dátumot és\n"		  
		"                    (feltételesen) az idõt a -t-vel megadottra\n."				  
		"                b. Ha -tt volt megadva, akkor lecseréljük az idõt a -tt -belire   \n."
		//                                                         1990.01.01. 00:00:00      
		"                c. Átszámítjuk az EXIF dátumot és idõt az" << BASE_YEAR << ".01.01. 00:00:00\n"
		"                   óta eltelt másodpercek számára.\n"							  
		"                d. Hozzáadjuk az 1. pont alatt meghatározott másodperceket.\n"	  
		"                e. Visszaalakítjuk a másodperceket EXIF formátumúra\n"			  
		"                   a megfelelõ határoló karakterekkel és lecseréljük a dátumot\n"
		"                   a memóriában\n"												  
		"                f. Ha a -l opciót megadtuk a módosított dátumot kiíratjuk a\n"
		"                   képernyõre és nem folytatjuk az EXIF dátumok keresését, csak\n"
		"                   áttérünk a következõ fájlra\n"												  
		"              3.3  Ha nem volt -l, akkor a móódosított fájlt egy ideiglenes\n"
		"                   névvel kiírjuk a diszkre. Az eredeti fájl nem változik.\n"			  
		"              3.4. Ha a kiírás sikeres átnevezzük az eredeti fájlt: hozzáadunk\n"
		"                   egy ~ karaktert a nevéhez\n"										  
		"              3.5. Ha a -n opciót is megadtuk az eredeti fájlt letöröljük.\n"	   
		"              3.6. Átnevezzük az új fájlt a régi nevére és a fájl dátumát is\n"
		"                    átírjuk az eredetiére.\n"
		"(C) Sólyom András 2015-2016\n"
		;

	return 1;
}

/*======================================================================*/
int UsageHu(STRING sName)
/*----------------------------------------------------------------------*/
{
	COUT << sName << "\n"
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 
		"Modern kamerák és telefonok a felvételkészítés idõpontját is rögzítik a kép\n"
		"fájlokban, az ún. EXIF fejlécben. Modern lapbeolvasók is megteszik ezt a\n"
		"beolvasás dátumával. Ha a dátum/idõ hibásan volt beállítva a kamerában akkor\n"
		"hibás dátum kerül a képekbe is.\n"
		"Hasonlóképpen át akarhatjuk állítani egy beolvasott fotóban tárolt dátumot az\n"
		"eredeti fotó készítésének dátumára\n"
		"Ezzel a programmal módosíthatjuk a kép fájlok fejlécében található dátumot és\n"
		"idõt.\n\n"
		"Jelmagyarázat:\n"
		"    szöveg <> -ben: kötelezõ paraméter megnevezése,\n"
		"    szöveg []-ben nem kötelezõ paraméter megnevezése.\n"
		"    A | jel két oldalán megadott paraméterek bármelyike megadható, de csak az\n"
		"     egyik.\n"
		"    Például: -d|D<napok száma> azt jelenti, hogy a napok számát megadhatjuk\n"
		"     vagy a -d vagy a -D opcióval. Ha a dátumot 5 nappal korábbra akarjuk\n"
		"     állítani, akkor ehhez a -D5 opciót kell használjuk.\n"
		"    A | jelet soha nem írjuk be!"
		"A program használata:\n" 
		<< sName << " [opciók] <fájl, vagy mappa név> [<fájl, vagy mappa név> [...] ]\n"
		" Alap opciók:\n"	   
		" -h[h|e]: súgó kiíratás a gép területi beállítása szerint angol vagy magyar\n"
		"           nyelven. A []-ben levõ opciókat akkor használjuk, ha nem a területi\n"
		"          beállítások szerinti nyelvet akarjuk használni (-hh magyar,-he angol)\n"
		" -ha[e|h] algoritmus súgójának kiíratása.\n"											   
		" -e: ne tartsa meg az eredeti fájlokat. Ha nem adjuk meg, akkor az eredeti\n"
		"     fájlokat a program nem törli le, csak egy ~ karaktert ragaszt az eredeti\n"
		"     név végére."
		"     FIGYELEM: *** NEM vállalunk semmilyen felelõsséget *** azért, hogy a\n"
		"     módosított fájlok továbbra is használhatóak lesznek, úgyhogy ezt az opciót\n"
		"     mindenki csk a saját felelõsségére használja!\n"										   
		" -r: reguláris kifejezések használata a fájlok keresésénél. Ha nem tudja mik\n"
		"     azok, ne használja ezt az opciót!\n"												   
		"     Fájl nevekben (mappa nevekben nem!) -r nélkül is használhatja a szokásos\n"
		"     (*, ?, stb) dzsókereket, pl. \"*.jpg\"\n"															   
		" -l: csak listázza ki az új dátumokat de ne módosítsa a fájlokat\n\n"			   
		"<fájl vagy mappa név> : lehet egy fájl neve, egy mappa neve, vagy egy mappán\n"
		"     belül több, adott név mintának megfelelõ fájl.\n\n"
																						   
		"Módosítási opciók: (dátum és idõ változtatása):\n"								   
		" -t<dátum>[<idõ>]: alap dátum és idõ beállítása. A többi opció ezt módosítja\n"   
		"    Formátum: ÉÉÉÉHHNN[ÓÓPP[SS]]\n"											   
		" -tt<idõ>       : csak az idõ (ÓÓPPSS) beállítása. A dátum változatlan marad.\n"
		" A továbbiakban a kisbetûk a <> értékének dátumhoz/idõhöz hozzáadását, a nagy\n"
		" betûk a a levonását jelentik, vagyis -d12 hozzáad 12 napot a dátumhoz, \n"
		" -D12 levon belõle 12 napot. Nem lehet betûköz az opció és a szám között!\n"
		" -d|D<napok száma> \n"
		" -m|m<hónapok száma>\n"
		" -y|Y<évek száma>\n"
		" -o|O<órák száma>\n"
		" -n|N<percek száma>\n"
		" -s|S<másodpercek>\n\n"
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 
		"Egyidejûleg több opciót is használhatunk.\n"
		"Ha -y vagy -Y opciót használunk és az eredeti, vagy a módosított EXIF év szökõév, akkor\n"
		"   a hónap és a nap is változik! A nyári idõszámítással a program nem foglalkozik.\n"
		"Ha egy opció többször szerepe, mindig az utolsó az érvényes.\n"
		"A módosítások sorrendje: Elõször a -t (ha van), majd a -tt  (ha van) opciókat\n"
		"alkalmazza a program, ezt követik a többiek.\n\n"
		"Példa (Windows): " << sName << " -t20150308 \"C:\\hibás dátumok\\pista*.jpg\"\n"
		"      (Linux) : " << sName << " -t20150308 /hibás\\ dátumok/pista*.jpg\n\n";

	return 1;
}
/*======================================================================*/
int UsageEng(STRING sName)
/*----------------------------------------------------------------------*/
{
	COUT << sName << 
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 
		"EXIF date and time modifier V2.0 for image and sidecar (.xmp) files\n"
		"Usage: " << sName << " [options] <file name> [<file name> [...] ]\n"
		" where options are:\n"
		" -h: print this help. The system language determines the help language.\n"
		"       Only English and Hungarian languages are supported however\n"
		" -h<h|e>: print help in Hungarian or in English\n"
		" -ha[e|h]: print algorithm help in system language, English or Hungarian\n"
		" -e: DELETE original files. If not given original files are kept with a tilde\n"
		"     (~) appended to the original file name\n"
		"     **** WARNING *** Use this option at your own risk! We give no guarantee\n"
		"     that the modified files will be good image files. You have been warned!\n"
		" -r: use regular expressions to match file name. No problem if you do not know\n"
		"     what those are. You can still use wildcards (e.g. * ?) what your OS\n"
		"     understands."
		" -l: only list modified dates but do not change the files\n\n"

		"Modification options (date and time offsets):\n"
		" -t<date>[<time>]: set EXIF date (and optionally time).\n"
		"    Format: YYYMMDD[HHMM[SS]]\n"
		" -tt<time>       : set EXIF time and leave date intact.\n"
		"    Format: HHMM[SS]\n\n"
		" -d<days to add \n"
		" -D<days to subtract\n"
		" -m<months to add>\n"
		" -M<months to subtract>\n"
		" -y<years to add>\n"
		" -Y<years to subtract>\n"
		" -o<hours to add>\n"
		" -O<hours to subtract>\n"
		" -n<minutes to add>\n"
		" -N<minutes to subtract>\n"
		" -s<seconds to add>\n\n"
		" -S<seconds to subtract>\n\n"
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 
		"More than one modification option may be used at the same time.\n"
		"When -y or -Y is used and the original or modified EXIF year is a leap year\n"
		"   then the month and day will also change!\n"
		"If an option occurs more than once the last one will be in effect.\n"
		" Modification order: Option -t<> is applied first followed by the others.\n\n"
		"<file name> : file path where the file name may contain a regular expression.\n"
		"Example: " << sName << " -b -t20150308 this\\path\\*.NEF\n"
		;
//				   1         2		   3		 4		   5		 6		   7
//       0123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789
	return(1);
}

/*======================================================================*/
int Usage(STRING sName, const TCHAR *pch=nullptr)
/*----------------------------------------------------------------------*/
{
	locale loc = COUT.getloc();
	int lang = loc.name().find_first_of("_hu") == string::npos; // english
	if (pch)
	{
		if (pch[2] == 'a') // algorithm help?
		{
			if (pch[3] == 'e')
				return AlgoEng(sName);
			else if (pch[3] == 'h')
				return AlgoHu(sName);
			else
				return lang ? AlgoEng(sName) : AlgoHu(sName);
		}
		else
		{
			if (pch[2] == 'e')
				return UsageEng(sName);
			else if (pch[2] == 'h')
				return UsageHu(sName);
			else
				return lang ? UsageEng(sName) : UsageHu(sName);
		}
	}
	return  lang ? UsageEng(sName) : UsageHu(sName);
}

/*======================================================================*/
int main(int argc, TCHAR **argv)
/*----------------------------------------------------------------------*/
{
	TCHAR *pszName = argv[0];
	if (argc == 1 || (argc == 2 && *argv[1] == '-' && argv[1][1] == 'h'))
		return Usage(GetProgramName(*argv), argv[1]);

	DateTimeShift	shift,		// from other options
		shiftT;		// from option -t<>
	bool listDateAndTime = false;

	SA_FILES saFiles;

	while (--argc)
	{
		++argv;
		try
		{
			if (argv[0][0] == '-')
			{
				switch (argv[0][1])
				{
				case 'D': shift._d = -stoi(argv[0] + 2); break;	// -days
				case 'M': shift._m = -stoi(argv[0] + 2); break;	// -months
				case 'N': shift._n = -stoi(argv[0] + 2); break;	// -minutes
				case 'O': shift._h = -stoi(argv[0] + 2); break;	// -hours
				case 'S': shift._s = -stoi(argv[0] + 2); break;	// -seconds
				case 'Y': shift._y = -stoi(argv[0] + 2); break;	// -years

				case 'e': shift._keepOld = false;			  break;

				case 'd': shift._d = stoi(argv[0] + 2); break;	// +days
				case 'h': return Usage(GetProgramName(*argv));
				case 'l': listDateAndTime = true; break;
				case 'm': shift._m = stoi(argv[0] + 2); break;	// +months
				case 'n': shift._n = stoi(argv[0] + 2); break;	// +minutes
				case 'o': shift._h = stoi(argv[0] + 2); break;	// +hours
				case 's': shift._s = stoi(argv[0] + 2); break;	// +seconds
				case 'y': shift._y = stoi(argv[0] + 2); break;	// +years
				case 't': if ((argv[0][2] == 't' && shiftT.SetTime(argv[0] + 3)) || (shiftT.SetDate(argv[0] + 2)))
					break;
				default: return Usage(GetProgramName(*argv));
				}
			}
			else			// get all file names and process them each
			{
				saFiles.Add(STRING(argv[0]));		// get all files which matches the path to list
			}
		}
		catch (...)
		{
			COUT << L("invalid modification parameters!\nExiting.\n");
			return -1;
		}
	}

	STRING name;
	for (int i = 0; i < saFiles.Count(); ++i)
	{
		name = saFiles.Name(i);
		ModDate modDate(name, shift, shiftT);
		int err;
		if ((err = modDate.ReadImageFile()) != 0)	// then error
			return err;
		 	// if listDateAndTime true do not write new file
		if(modDate.Modify(!listDateAndTime) > 0)  // otherwise an error occured and signalled
			COUT << modDate;		// display EXIF date
	}
	return 0;
}
